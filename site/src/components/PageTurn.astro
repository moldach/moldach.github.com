---
import { chapters } from '../lib/registry';
interface Props {
  initialChapter?:
    'start' | 'services' | 'work' | 'writing' | 'about' | 'contact';
  navigation?: boolean;
}
const { initialChapter = 'start', navigation = false } = Astro.props;
const initialLabel = chapters.find(
  (c) => c.label.toLowerCase() === initialChapter,
)!.label;
---

<section
  data-page-turn
  data-initial={initialChapter}
  data-navigation={navigation ? 'page' : 'review'}
  class:list={[{ integrated: navigation }]}
  aria-label={`${initialLabel} chapter book`}
>
  <div class="stage" data-stage>
    <img
      src={
        initialChapter === 'start'
          ? '/models/start/poster.webp'
          : `/models/chapters/${initialChapter}.webp`
      }
      alt={`${initialLabel} chapter pop-up book`}
      width="1536"
      height="1024"
      fetchpriority="high"
    />
    <canvas
      tabindex="0"
      aria-label="Paper book prototype. Use the six chapter links to change pages. Drag to inspect the settled scene."
    ></canvas>
    <nav class="tabs" aria-label="Book chapters">
      {chapters.map((chapter, i) => (
        <a
          href={chapter.href}
          data-chapter={i}
          aria-current={
            chapter.label.toLowerCase() === initialChapter ? 'page' : undefined
          }
          style={`left:${8 + i * 14.3}%;top:87%;width:12%;height:6%`}
        >
          <span>{chapter.label}</span>
        </a>
      ))}
    </nav>
  </div>
  <div class="review-actions">
    <p role="status" aria-live="polite">
      Opening {initialLabel}…
    </p>
    <button type="button" data-retry hidden>
      Retry chapter
    </button>
    <a
      href={chapters.find((c) => c.label === initialLabel)!.href}
      data-open-chapter
    >
      Open {initialLabel} chapter page ↗
    </a>
    <a href="/services/">Open Services page ↗</a>
  </div>
  <p class="help">
    Choose a chapter to turn through the book in order. Viewing{' '}
    <strong data-current>{initialLabel}</strong>. Keyboard and reduced-motion
    navigation switch directly.
  </p>
  <noscript>
    <p>
      Use the chapter links to open the regular pages. The animated prototype
      needs JavaScript.
    </p>
    <style is:inline>
      [data-page-turn] [role='status'] {
        display: none;
      }
    </style>
  </noscript>
  <pre data-metrics hidden></pre>
</section>
<script>
  import { mountPageTurn } from './page-turn/runtime';
  const mount = () =>
    document
      .querySelectorAll<HTMLElement>('[data-page-turn]')
      .forEach((root) => void mountPageTurn(root));
  mount();
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) mount();
  });
</script>
<style>
  .integrated {
    width: 100%;
    max-width: 1536px;
    margin: 0 auto 24px;
    min-width: 0;
  }
  .integrated .help,
  .integrated .review-actions a {
    display: none;
  }
  .integrated[data-state='error'] .review-actions a[data-open-chapter] {
    display: inline;
  }
  .integrated [role='status'] {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }
  .stage {
    aspect-ratio: 3/2;
    position: relative;
    background: #f2ede3;
    overflow: hidden;
    border-radius: 8px;
  }
  img,
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  canvas {
    opacity: 0;
    touch-action: pan-y;
    cursor: grab;
  }
  [data-ready] canvas {
    opacity: 1;
  }
  [data-ready] img {
    visibility: hidden;
  }
  .tabs {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .tabs :global(a) {
    position: absolute;
    pointer-events: auto;
    border-radius: 3px;
  }
  .tabs :global(span) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }
  .tabs :global(a):focus-visible,
  canvas:focus-visible {
    outline: 3px solid #245ed0;
    outline-offset: -3px;
    background: #245ed015;
  }
  .tabs :global(a[hidden]) {
    display: none;
  }
  .review-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 24px;
    font-size: 14px;
  }
  button {
    font: inherit;
    padding: 10px 16px;
    border: 1px solid #c6bba8;
    border-radius: 24px;
    background: #fff9ef;
    cursor: pointer;
  }
  button[hidden] {
    display: none;
  }
  .help {
    font-size: 13px;
    color: #53616a;
  }
</style>
