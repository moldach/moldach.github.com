---
import { Image } from 'astro:assets';
import Page from '../../layouts/Page.astro';
import { pages, writingEntries, writingHref } from '../../lib/registry';
import umap from '../../../../project/supervised-umap/featured.png';
import fitbit from '../../../../project/fitbit-project/featured.png';
import brain from '../../../../project/3d-brain/featured.png';
const entries = await writingEntries();
const selected = entries
  .filter((entry) => entry.data.featuredOrder !== undefined)
  .sort((a, b) => a.data.featuredOrder! - b.data.featuredOrder!);
const covers: Record<string, { src: typeof umap; alt: string }> = {
  'supervised-umap': {
    src: umap,
    alt: 'Original UMAP presentation cover with red and blue clusters',
  },
  'fitbit-gamification': {
    src: fitbit,
    alt: 'Green pixel-art scene from the original Fitbit gamification project',
  },
  'highlighting-3d-brain-regions': {
    src: brain,
    alt: 'Original brain rendering with a small red highlighted region',
  },
};
---

<Page
  {...pages['/writing/']}
  breadcrumbs={[
    { label: 'Start', href: '/' },
    { label: 'Writing', href: '/writing/' },
  ]}
>
  <header class="page-intro wrap">
    <p class="eyebrow">Experiments, explanations, lessons</p>
    <h1>Notes from the work.</h1>
    <p class="intro">
      Software, data and visualisation, explained through things I have worked
      on. Original dates stay attached to the work.
    </p>
  </header>
  <section class="section wrap" aria-labelledby="featured-writing">
    <h2 id="featured-writing">Open a featured article.</h2>
    <div class="feature-articles">
      {selected.map((entry) => (
        <a
          class="article-exhibit"
          href={writingHref(entry)}
          data-article-id={entry.id}
        >
          <Image
            src={covers[entry.id].src}
            alt={covers[entry.id].alt}
            width={460}
            format="webp"
            loading="lazy"
          />
          <h3>{entry.data.title}</h3>
          <p>
            {entry.data.externalUrl
              ? 'Read the original published article ↗'
              : 'Read the article →'}
          </p>
        </a>
      ))}
    </div>
  </section>
  <section class="section wrap" aria-labelledby="all-writing">
    <p class="eyebrow">Publication order, newest first</p>
    <h2 id="all-writing">The writing archive.</h2>
    <ol class="writing-list">
      {entries.map((entry) => (
        <li>
          <time datetime={entry.data.publishedAt}>
            {entry.data.publishedAt}
          </time>
          <div>
            <h3>
              <a href={writingHref(entry)}>{entry.data.title}</a>
            </h3>
            <p>{entry.data.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>
</Page>
