---
import { siteConfig } from '../../lib/site-config.mjs';
export function getStaticPaths() {
  return siteConfig(process.env).production
    ? []
    : [{ params: { scene: 'start' } }];
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta
      name="description"
      content="Private Start asset review: dynamic paper materials, three studio lighting presets and rendering diagnostics."
    />
    <title>Start — dynamic lighting review</title>
    <link rel="icon" href="data:," />
  </head>
  <body>
    <main data-start-review>
      <header>
        <div>
          <a href="/">← Website preview</a>
          <h1>Start, in the light.</h1>
          <p>Ten approved visuals. Real geometry. Dynamic light.</p>
        </div>
        <span class="badge">ASSET REVIEW · NOT THE HOMEPAGE</span>
      </header>
      <div class="toolbar" aria-label="Lighting controls">
        <fieldset>
          <legend>Lighting</legend>
          <label>
            <input type="radio" name="lighting" value="studio" checked /> Studio
          </label>
          <label>
            <input type="radio" name="lighting" value="neutral" /> Neutral
          </label>
          <label>
            <input type="radio" name="lighting" value="contrast" /> Contrast
          </label>
        </fieldset>
        <label class="exposure">
          Exposure{' '}
          <input
            aria-label="Exposure"
            type="range"
            min="0.5"
            max="2"
            value="1.5"
            step="0.05"
          />
          <output>1.5</output>
        </label>
        <button type="button" data-reset>
          Reset view
        </button>
        <button type="button" data-close>
          Close 3D review
        </button>
      </div>
      <section class="stage" aria-label="Interactive Start book asset">
        <img
          data-poster
          src="/models/start/poster.webp"
          width="1536"
          height="1024"
          alt="Blender comparison baseline: paper book with terminal, three film loops, ten approved article images and six chapter tabs."
        />
        <canvas
          aria-label="Start book model. Drag to inspect or use arrow keys; Escape restores the reference view."
          tabindex="0"
        ></canvas>
        <p class="status" role="status" aria-live="polite">
          Loading the dynamic scene…
        </p>
      </section>
      <div class="below">
        <p>
          Drag to inspect · Arrow keys to rotate · Escape to reset.{' '}
          <a href="/writing/faststyletransfer/">
            Read the style-transfer article ↗
          </a>
        </p>
        <button type="button" data-measure>
          Measure 120 frames
        </button>
      </div>
      <details>
        <summary>Rendering diagnostics</summary>
        <pre data-metrics>Waiting for model…</pre>
      </details>
      <p class="note">
        Lighting, highlights and shadows are dynamic. Only paper surface normals
        are baked. The model is prepared for later animation; no page-turn or
        exhibit interactions are added here. Activation atlas: referenced{' '}
        <a href="https://distill.pub/2019/activation-atlas/">
          Distill research
        </a>
        .
      </p>
    </main>
    <noscript>
      <p>
        JavaScript is disabled. The Blender baseline and article link remain
        available.
      </p>
      <style is:inline>
        .status {
          display: none;
        }
      </style>
    </noscript>
    <script>
      import { mountStartReview } from '../../components/book-review/runtime';
      const root = document.querySelector<HTMLElement>('[data-start-review]');
      if (root) mountStartReview(root);
    </script>
    <style>
      :global(*) {
        box-sizing: border-box;
      }
      :global(body) {
        margin: 0;
        background: #f6f1e7;
        color: #182630;
        font-family: Arial, sans-serif;
      }
      main {
        max-width: 1584px;
        margin: auto;
        padding: 32px 24px;
      }
      header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
      }
      h1 {
        font:
          clamp(28px, 4vw, 44px) Georgia,
          serif;
        margin: 12px 0 8px;
      }
      header p,
      .note,
      .below {
        color: #53616a;
        font-size: 14px;
        line-height: 1.6;
      }
      a {
        color: #18488b;
        text-underline-offset: 3px;
      }
      .badge {
        font-size: 11px;
        letter-spacing: 0.12em;
        color: #486070;
      }
      .toolbar {
        display: flex;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
        margin: 24px 0 16px;
      }
      fieldset {
        border: 0;
        padding: 0;
        margin: 0;
        display: flex;
        gap: 14px;
      }
      legend {
        font-size: 11px;
        color: #53616a;
        margin-bottom: 7px;
      }
      label {
        font-size: 14px;
      }
      .exposure {
        display: flex;
        align-items: center;
        gap: 8px;
      }
      button {
        font: inherit;
        font-size: 13px;
        background: #fffaf1;
        border: 1px solid #bfc4c4;
        border-radius: 6px;
        padding: 10px 14px;
        cursor: pointer;
      }
      button:focus-visible,
      input:focus-visible,
      canvas:focus-visible {
        outline: 3px solid #245ed0;
        outline-offset: 3px;
      }
      .stage {
        position: relative;
        aspect-ratio: 3/2;
        background: #eee7db;
        overflow: hidden;
        border-radius: 8px;
      }
      .stage img,
      .stage canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: contain;
      }
      .stage canvas {
        opacity: 0;
        touch-action: pan-y;
        cursor: grab;
      }
      .stage[data-ready] canvas {
        opacity: 1;
      }
      .stage[data-ready] img {
        visibility: hidden;
      }
      .status {
        position: absolute;
        bottom: 12px;
        left: 16px;
        margin: 0;
        background: #fffaf1ed;
        padding: 7px 10px;
        border-radius: 4px;
        font-size: 12px;
        max-width: 90%;
      }
      .below {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }
      .below p {
        margin: 14px 0;
      }
      details {
        font-size: 13px;
        border-top: 1px solid #d9d0c1;
        padding-top: 14px;
      }
      pre {
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        line-height: 1.5;
      }
      .note {
        max-width: 1000px;
      }
      output {
        min-width: 30px;
      }
      input[type='range'] {
        max-width: 120px;
      }
      @media (max-width: 650px) {
        main {
          padding: 20px 12px;
        }
        .badge {
          display: none;
        }
        .toolbar {
          gap: 12px;
        }
        fieldset {
          width: 100%;
        }
        .below {
          align-items: start;
        }
        .stage {
          border-radius: 0;
        }
        .status {
          bottom: 5px;
          left: 5px;
          font-size: 10px;
        }
      }
    </style>
  </body>
</html>
