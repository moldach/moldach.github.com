---
import { siteConfig } from '../../lib/site-config.mjs';
import ChapterBook from '../../components/ChapterBook.astro';
export function getStaticPaths() {
  return siteConfig(process.env).production
    ? []
    : [{ params: { scene: 'start' } }];
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta
      name="description"
      content="Matthew Oldach’s interactive paper book with fixed Studio lighting and chapter navigation."
    />
    <title>Start — Matthew Oldach</title>
    <link rel="icon" href="data:," />
  </head>
  <body>
    <main>
      <header>
        <a href="/">Matthew Oldach</a>
        <h1>Practical AI. Less busywork.</h1>
        <p>Explore a chapter.</p>
      </header>
      <ChapterBook chapter="Start" />
    </main>
    <style>
      :global(*) {
        box-sizing: border-box;
      }
      :global(body) {
        margin: 0;
        background: #f6f1e7;
        color: #182630;
        font-family: Arial, sans-serif;
      }
      main {
        max-width: 1584px;
        padding: 28px 24px;
        margin: auto;
      }
      h1 {
        font:
          clamp(26px, 4vw, 40px) Georgia,
          serif;
      }
      a {
        color: #18488b;
      }
      header p {
        color: #53616a;
      }
      @media (max-width: 650px) {
        main {
          padding: 20px 12px;
        }
      }
    </style>
  </body>
</html>
