---
import { Image } from 'astro:assets';
import Page from '../layouts/Page.astro';
import PageTurn from '../components/PageTurn.astro';
import ProjectVideo from '../components/ProjectVideo.astro';
import WritingExhibits from '../components/WritingExhibits.astro';
import {
  pages,
  serviceEntries,
  writingEntries,
  writingHref,
} from '../lib/registry';
import assessment from '../../../research/design/chapters/round-2/02-services.png';
import implementation from '../../../research/design/chapters/round-2/03-work.png';
import adoption from '../../../research/design/chapters/round-2/05-about.png';
import putting from '../../../research/design/chapters/putting-area-reference-v1.png';
import filters from '../../../project/shiny-filters/featured.jpg';
const services = await serviceEntries();
const serviceArt = [assessment, implementation, adoption];
const serviceSummary = [
  'Find the workflow worth improving.',
  'Make one useful thing work.',
  'Give your team the confidence to use it.',
];
const latest = (await writingEntries()).slice(0, 3);
---

<Page {...pages['/']}>
  <PageTurn initialChapter="start" navigation />
  <section class="home-intro wrap" aria-labelledby="home-title">
    <div class="hero-copy">
      <p class="eyebrow">Small-business AI consulting · Remote, worldwide</p>
      <h1 id="home-title">
        Practical AI.
        <br />
        Less busywork.
      </h1>
      <p class="intro">
        Turn repetitive work into useful systems—with AI, thoughtful software
        and a person who understands both.
      </p>
      <div class="hero-actions">
        <a class="button" href="/services/ai-opportunity-assessment/">
          Find your opportunity <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="#selected-work">
          See what I make ↓
        </a>
      </div>
    </div>
  </section>
  <section
    class="visual-work wrap"
    id="selected-work"
    aria-labelledby="work-title"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">Software. Data. A little play.</p>
        <h2 id="work-title">Ideas you can see.</h2>
      </div>
      <a href="/work/">Explore the work ↗</a>
    </div>
    <div class="project-gallery">
      <article class="gallery-project gallery-maps">
        <div class="gallery-media">
          <ProjectVideo
            src="/media/hinuhinu-walkthrough.mp4"
            poster="/media/hinuhinu-poster.webp"
            label="Original Hinuhinu Oahu terrain flyby excerpt"
          />
          <span class="media-badge">Original terrain flyby</span>
        </div>
        <div class="gallery-caption">
          <div>
            <p class="eyebrow">Interactive cartography</p>
            <h3>
              <a href="/work/#hinuhinu">A different view of Hawaiʻi.</a>
            </h3>
            <p>Hinuhinu · Maps made for exploring.</p>
          </div>
          <a
            class="circle-link"
            href="/work/#hinuhinu"
            aria-label="Explore Hinuhinu"
          >
            ↗
          </a>
        </div>
      </article>
      <article class="gallery-project gallery-putting">
        <a class="gallery-media putting-image" href="/work/#puttpulse">
          <Image
            src={putting}
            alt="Disc-golf basket on a raised mulch bed, surrounded by a circle of plastic marking whiskers"
            width={800}
            format="webp"
            loading="lazy"
          />
          <span class="media-badge">Paper-world concept</span>
        </a>
        <div class="gallery-caption">
          <div>
            <p class="eyebrow">Product & play</p>
            <h3>
              <a href="/work/#puttpulse">Practice, with purpose.</a>
            </h3>
            <p>PuttPulse · A better putting session.</p>
          </div>
          <a
            class="circle-link"
            href="/work/#puttpulse"
            aria-label="Explore PuttPulse"
          >
            ↗
          </a>
        </div>
      </article>
      <article class="gallery-project gallery-filters">
        <a class="gallery-media filter-image" href="/work/#shiny-filters">
          <div class="filter-orbit" aria-hidden="true"></div>
          <Image
            src={filters}
            alt="Original Shiny-filteRs application showing a Voronoi-filtered portrait"
            width={400}
            format="webp"
            loading="lazy"
          />
          <span class="media-badge">Original application image</span>
        </a>
        <div class="gallery-caption">
          <div>
            <p class="eyebrow">Creative computation</p>
            <h3>
              <a href="/work/#shiny-filters">Code, meet colour.</a>
            </h3>
            <p>Shiny-filteRs · A playful image lab.</p>
          </div>
          <a
            class="circle-link"
            href="/work/#shiny-filters"
            aria-label="Explore Shiny-filteRs"
          >
            ↗
          </a>
        </div>
      </article>
    </div>
  </section>
  <section class="cinema-section" aria-labelledby="cinema-title">
    <div class="cinema-inner wrap">
      <div class="cinema-copy">
        <p class="eyebrow">From the archive · TensorFlow style transfer</p>
        <h2 id="cinema-title">
          A creative streak.
          <br />
          Written in code.
        </h2>
        <p>
          An experiment in giving touring footage a different visual language.
          Original motion from my style-transfer project.
        </p>
        <a href="/writing/faststyletransfer/">Go inside the experiment ↗</a>
      </div>
      <div class="cinema-screen">
        <ProjectVideo
          src="/media/style-transfer.mp4"
          poster="/media/style-transfer-poster.webp"
          label="Original TensorFlow style-transfer animation from Matthew's article"
        />
        <span class="cinema-index" aria-hidden="true">
          01 / Creative computation
        </span>
      </div>
    </div>
  </section>
  <section
    class="section wrap visual-services"
    aria-labelledby="services-title"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">Three ways to work together</p>
        <h2 id="services-title">Make room for better work.</h2>
      </div>
      <a href="/services/">Compare engagements ↗</a>
    </div>
    <ol class="service-gallery">
      {services.map((service, i) => (
        <li>
          <a href={`/services/${service.id}/`}>
            <div class="service-art">
              <Image
                src={serviceArt[i]}
                alt={
                  [
                    'Paper drafting table illustrating how a workflow becomes an implementation plan',
                    'Paper project exhibition representing a focused software build',
                    'Paper strategy table representing team practice and adoption',
                  ][i]
                }
                width={660}
                format="webp"
                loading="lazy"
              />
            </div>
            <div class="service-caption">
              <span class="ordinal">0{i + 1}</span>
              <h3>{service.data.shortTitle}</h3>
              <span class="arrow-link" aria-hidden="true">
                ↗
              </span>
            </div>
            <p>{serviceSummary[i]}</p>
          </a>
        </li>
      ))}
    </ol>
  </section>
  <section class="section wrap home-writing" aria-labelledby="writing-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Open the notebook</p>
        <h2 id="writing-title">Curiosity leaves a trail.</h2>
      </div>
      <a href="/writing/">All writing ↗</a>
    </div>
    <WritingExhibits />
    <div class="latest-strip">
      <p class="eyebrow">Latest, by original publication date</p>
      <ol>
        {latest.map((entry) => (
          <li>
            <time datetime={entry.data.publishedAt}>
              {entry.data.publishedAt}
            </time>
            <a href={writingHref(entry)}>{entry.data.title} ↗</a>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Page>
