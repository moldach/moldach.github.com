---
import Page from '../layouts/Page.astro';
---

<Page
  title="Page not found"
  seoTitle="Page Not Found | Matthew Oldach"
  description="This address does not match a page. Explore Matthew Oldach's services, work or writing instead."
  primaryIntent="Recover from an unknown address"
  noindex
>
  <section class="page-intro not-found wrap">
    <p class="eyebrow">404</p>
    <h1>A page out of place.</h1>
    <p>
      That address does not match a page here. Try{' '}
      <a href="/writing/">the writing archive</a>,{' '}
      <a href="/services/">services</a> or <a href="/">the start of the book</a>
      .
    </p>
  </section>
</Page>
